import React, { useEffect, useState } from 'react';
import { 
  View, Text,  TextInput, TouchableOpacity, FlatList, StyleSheet, Alert,Platform} from "react-native";
import { getRoles, postRol, deleteRol } from "../api/RolApi"; 
export default function Rol() {
  const [roles, setRoles] = useState([]);
  const [nuevoRol, setNuevoRol] = useState('');
  const [cargando, setCargando] = useState(false);

  useEffect(() => {
    llamadaApi();
  }, []);

  async function llamadaApi() {
    try {
      const datos = await getRoles();
      setRoles(datos);
    } catch (error) {
      console.error("Error al cargar roles:", error);
    }
  }

  const mostrarMensaje = (titulo, mensaje) => {
    if (Platform.OS === 'web') {
      alert(`${titulo}: ${mensaje}`);
    } else {
      Alert.alert(titulo, mensaje);
    }
  };

  async function handleCrearRol() {
    if (!nuevoRol.trim()) {
      return mostrarMensaje("Atención", "Ingresa un nombre de rol válido");
    }

    try {
      setCargando(true);
      await postRol(nuevoRol.trim());
      setNuevoRol('');
      await llamadaApi(); 
    } catch (error) {
      console.error("Error al crear el rol:", error);
      mostrarMensaje("Error", "No se pudo crear el rol");
    } finally {
      setCargando(false);
    }
  }


  async function handleEliminarRol(id, nombre) {
    const confirmarYEliminar = async () => {
      try {
       
        await deleteRol(id);
        
       
        setRoles((prev) => prev.filter((r) => (r._id || r.id) !== id));
        mostrarMensaje("Eliminado", `El rol "${nombre}" fue eliminado.`);
      } catch (error) {
        console.error("Error al eliminar rol:", error);
        mostrarMensaje("Error", "No se pudo eliminar el rol");
      }
    };

    if (Platform.OS === 'web') {
      if (window.confirm(`¿Estás seguro de eliminar el rol "${nombre}"?`)) {
        await confirmarYEliminar();
      }
    } else {
      Alert.alert(
        "Eliminar Rol",
        `¿Estás seguro de eliminar el rol "${nombre}"?`,
        [
          { text: "Cancelar", style: "cancel" },
          { text: "Eliminar", style: "destructive", onPress: confirmarYEliminar }
        ]
      );
    }
  }

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>Gestión de Roles</Text>

      
      <View style={styles.formContainer}>
        <Text style={styles.subtitulo}>Escribe el nuevo rol</Text>
        <TextInput
          style={styles.input}
          placeholder="Nombre del nuevo rol (ej. Admin, Vendedor)"
          placeholderTextColor="#64748b"
          value={nuevoRol}
          onChangeText={setNuevoRol}
        />
        <TouchableOpacity 
          style={[styles.boton, cargando && styles.botonDesactivado]} 
          onPress={handleCrearRol}
          disabled={cargando}
        >
          <Text style={styles.textoBoton}>
            {cargando ? "Guardando..." : "Guardar Rol"}
          </Text>
        </TouchableOpacity>
      </View>

     
      <Text style={styles.subtitulo}>Lista de Roles</Text>
      <FlatList
        data={roles}
        keyExtractor={(item) => item._id || item.id || Math.random().toString()}
        renderItem={({ item }) => {
          const id = item._id || item.id;
          return (
            <View style={styles.itemCard}>
              <View style={styles.infoLeft}>
                <View style={styles.badge} />
                <Text style={styles.itemTexto}>{item.nombre}</Text>
              </View>

              {/* Botón Eliminar */}
              <TouchableOpacity 
                style={styles.botonEliminar}
                onPress={() => handleEliminarRol(id, item.nombre)}
              >
                <Text style={styles.textoEliminar}>✕</Text>
              </TouchableOpacity>
            </View>
          );
        }}
        ListEmptyComponent={
          <Text style={styles.textoVacio}>No hay roles registrados aún.</Text>
        }
      />
    </View>
  );
}



