import React, { useEffect, useState } from 'react';
import { 
  View, Text, TextInput,TouchableOpacity,FlatList, StyleSheet, Modal, Platform,ScrollView,Alert } from "react-native";
import { getUsers } from "../api/UserApi"; 
import { 
  getProfesionales,
  getCalificacionesPorProfesional, 
  crearCalificacion, 
  eliminarCalificacion 
} from "../api/CalificacionesApi";

export default function Calificaciones() {
  const [usuariosConPerfil, setUsuariosConPerfil] = useState([]);
  const [cargando, setCargando] = useState(true);


  const [modalVisible, setModalVisible] = useState(false);
  const [usuarioSeleccionado, setUsuarioSeleccionado] = useState(null);
  const [calificaciones, setCalificaciones] = useState([]);
  const [cargandoCalif, setCargandoCalif] = useState(false);

 
  const [puntuacion, setPuntuacion] = useState('');
  const [comentario, setComentario] = useState('');

  useEffect(() => {
    cargarDatos();
  }, []);

async function cargarDatos() {
    try {
      setCargando(true);
    
      const [resUsuarios, resProfesionales] = await Promise.all([
        getUsers(),
        getProfesionales().catch(() => []) 
      ]);

      const listaUsuarios = resUsuarios.users || resUsuarios || [];
      const listaProfesionales = Array.isArray(resProfesionales) ? resProfesionales : [];

    
      const profesionalesFiltrados = listaUsuarios
        .map(user => {
          const perfilEncontrado = listaProfesionales.find(p => {
        
            const rawIdProf = p.usuarioId?._id || p.usuarioId;
            if (!rawIdProf) return false;

         
            const idProfStr = String(rawIdProf._id || rawIdProf).trim();
            const userIdStr = String(user._id || user.id || '').trim();

            return idProfStr === userIdStr;
          });

          if (perfilEncontrado) {
            return {
              ...user,
              _id: perfilEncontrado._id, 
              usuarioRealId: user._id,    
              profesion: perfilEncontrado.profesion || "Profesional"
            };
          }
          return null; 
        })
        .filter(user => user !== null); 

      setUsuariosConPerfil(profesionalesFiltrados);
    } catch (error) {
      mostrarMensaje("Error", error.message || "No se pudieron cargar los datos");
    } finally {
      setCargando(false);
    }
  }
  
  async function handleVerUsuario(usuario) {
    setUsuarioSeleccionado(usuario);
    setModalVisible(true);
    setPuntuacion('');
    setComentario('');
    await recargarCalificacionesModal(usuario._id);
  }

  async function recargarCalificacionesModal(usuarioId) {
    try {
      setCargandoCalif(true);
      const data = await getCalificacionesPorProfesional(usuarioId);
      setCalificaciones(data);
    } catch (error) {
      setCalificaciones([]);
    } finally {
      setCargandoCalif(false);
    }
  }

  async function handleCrearCalificacion() {
    const numPuntuacion = Number(puntuacion);
    if (!puntuacion || numPuntuacion < 1 || numPuntuacion > 5) {
      mostrarMensaje("Atención", "La puntuación es obligatoria y debe ser un número del 1 al 5");
      return;
    }

    try {
      await crearCalificacion({
        profesionalId: usuarioSeleccionado._id,
        puntuacion: numPuntuacion,
        comentario
      });

      mostrarMensaje("Éxito", "Calificación agregada correctamente");
      setPuntuacion('');
      setComentario('');
      await recargarCalificacionesModal(usuarioSeleccionado._id);
    } catch (error) {
      mostrarMensaje("Error", error.message);
    }
  }

  async function handleDeleteCalificacion(idCalificacion) {
    try {
      await eliminarCalificacion(idCalificacion);
      mostrarMensaje("Éxito", "Calificación eliminada correctamente");
      await recargarCalificacionesModal(usuarioSeleccionado._id);
    } catch (error) {
      mostrarMensaje("Error", error.message);
    }
  }

  const mostrarMensaje = (titulo, mensaje) => {
    if (Platform.OS === 'web') {
      alert(`${titulo}: ${mensaje}`);
    } else {
      Alert.alert(titulo, mensaje);
    }
  };

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>Panel de Calificaciones</Text>
      <Text style={styles.subtitulo}>Visualiza y califica únicamente a los usuarios con perfil profesional</Text>
      
      {/* Lista filtrada solo con profesionales */}
      <FlatList
        data={usuariosConPerfil}
        keyExtractor={(item) => item._id || item.id || Math.random().toString()}
        refreshing={cargando}
        onRefresh={cargarDatos}
        renderItem={({ item }) => (
          <TouchableOpacity 
            style={styles.itemCard} 
            onPress={() => handleVerUsuario(item)}
          >
            <View style={styles.infoLeft}>
              <View style={styles.badge} />
              <View style={{ flex: 1 }}>
                <Text style={styles.itemTexto}>👤 {item.username || item.email}</Text>
                <Text style={styles.itemSubtexto}>💼 {item.profesion}</Text>
              </View>
            </View>
            <Text style={styles.verTexto}>Calificar ➔</Text>
          </TouchableOpacity>
        )}
        ListEmptyComponent={
          <Text style={styles.textoVacio}>No hay profesionales registrados.</Text>
        }
      />

     
      <Modal visible={modalVisible} animationType="slide" transparent={true}>
        <View style={styles.modalBackdrop}>
          <View style={styles.modalContainer}>
            
            <Text style={styles.modalTitulo}>
              Calificar a: {usuarioSeleccionado?.username}
            </Text>
            <Text style={styles.modalSubtitulo}>
              Profesión: {usuarioSeleccionado?.profesion}
            </Text>

            <ScrollView showsVerticalScrollIndicator={false}>
              
             
              <View style={styles.formContainer}>
                <Text style={styles.subtituloForm}>Añadir Nueva Calificación</Text>
                
                <TextInput 
                  style={styles.input} 
                  placeholder="Puntuación (1 al 5)" 
                  placeholderTextColor="#64748b" 
                  keyboardType="numeric"
                  value={puntuacion} 
                  onChangeText={setPuntuacion} 
                />
                
                <TextInput 
                  style={styles.input} 
                  placeholder="Comentario (opcional)" 
                  placeholderTextColor="#64748b" 
                  value={comentario} 
                  onChangeText={setComentario} 
                />

                <TouchableOpacity style={styles.botonCrear} onPress={handleCrearCalificacion}>
                  <Text style={styles.textoBotonCrear}>Guardar Reseña</Text>
                </TouchableOpacity>
              </View>

              <Text style={styles.subtituloForm}>Reseñas Existentes ({calificaciones.length})</Text>

             
              {cargandoCalif ? (
                <Text style={styles.textoVacio}>Cargando reseñas...</Text>
              ) : calificaciones.length === 0 ? (
                <Text style={styles.textoVacio}>Este profesional aún no tiene calificaciones.</Text>
              ) : (
                calificaciones.map((item) => (
                  <View key={item._id} style={styles.califCard}>
                    <View style={{ flex: 1, marginRight: 8 }}>
                      <Text style={styles.estrellas}>⭐ {item.puntuacion} / 5</Text>
                      <Text style={styles.comentarioText}>
                        "{item.comentario || 'Sin comentario'}"
                      </Text>
                      <Text style={styles.usuarioCalif}>
                        Por: {item.usuarioId?.username || 'Usuario'}
                      </Text>
                    </View>

                    <TouchableOpacity 
                      style={styles.botonEliminarCalif} 
                      onPress={() => handleDeleteCalificacion(item._id)}
                    >
                      <Text style={styles.textoEliminarCalif}>Eliminar</Text>
                    </TouchableOpacity>
                  </View>
                ))
              )}
            </ScrollView>

            <TouchableOpacity style={styles.botonCerrar} onPress={() => setModalVisible(false)}>
              <Text style={styles.textoCerrar}>Cerrar Ventana</Text>
            </TouchableOpacity>

          </View>
        </View>
      </Modal>

    </View>
  );
}




