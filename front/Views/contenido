import React, { useEffect, useState } from 'react';
import { 
  View, Text, TextInput,TouchableOpacity,FlatList, StyleSheet, Modal,Platform,ScrollView,Alert} from "react-native";
import AsyncStorage from "@react-native-async-storage/async-storage";
import { getUsers } from "../api/UserApi";
import { getCategorias } from "../api/CategoriaApi"; 

// URL base de tu API de profesionales
const API_URL_PROF = 'http://localhost:5000/api/profesionales';

export default function Profecionales() {
  const [usuarios, setUsuarios] = useState([]);
  const [profesionalesRegistrados, setProfesionalesRegistrados] = useState([]);
  const [listaCategorias, setListaCategorias] = useState([]); 
  const [cargando, setCargando] = useState(true);
  const [miIdUsuario, setMiIdUsuario] = useState(null);


  const [modalVisible, setModalVisible] = useState(false);
  const [tienePerfil, setTienePerfil] = useState(false);
  const [perfilActual, setPerfilActual] = useState(null);
  const [usuarioSeleccionadoId, setUsuarioSeleccionadoId] = useState(null);


  const [categoriaId, setCategoriaId] = useState(''); 
  const [profesion, setProfesion] = useState('');
  const [telefono, setTelefono] = useState('');
  const [ubicacion, setUbicacion] = useState('');
  const [descripcion, setDescripcion] = useState('');
  const [experienciaAnos, setExperienciaAnos] = useState('');

  useEffect(() => {
    cargarDatosIniciales();
  }, []);

  async function cargarDatosIniciales() {
    try {
      setCargando(true);
      const idLogueado = await AsyncStorage.getItem('usuarioId'); 
      setMiIdUsuario(idLogueado);

      const token = await AsyncStorage.getItem('token');
      
      
      const resUsuarios = await getUsers();
      setUsuarios(resUsuarios.users || []);

      const categoriasData = await getCategorias(); 
      setListaCategorias(categoriasData);

      const resProf = await fetch(API_URL_PROF, {
        headers: { 'Authorization': 'Bearer ' + token }
      });
      const dataProf = await resProf.json();
      if (resProf.ok) {
        setProfesionalesRegistrados(dataProf);
      }

    } catch (error) {
      mostrarMensaje("Error", "No se pudieron cargar los datos iniciales");
    } finally {
      setCargando(false);
    }
  }

  
  async function handleVerUsuario(usuario) {
    setUsuarioSeleccionadoId(usuario._id);

    const perfilEncontrado = profesionalesRegistrados.find(p => {
      const idDelProf = p.usuarioId?._id || p.usuarioId;
      return idDelProf === usuario._id;
    });

    if (perfilEncontrado) {
      setTienePerfil(true);
      setPerfilActual(perfilEncontrado);
    } else {
      setTienePerfil(false);
      setPerfilActual(null);
      setCategoriaId('');
    }
    setModalVisible(true);
  }

  async function handleCrearPerfil() {
    if (!profesion || !telefono || !ubicacion || !categoriaId) {
      mostrarMensaje("Atención", "Por favor completa los campos obligatorios y selecciona una categoría");
      return;
    }

    try {
      const token = await AsyncStorage.getItem('token');
      const respuesta = await fetch(API_URL_PROF, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + token,
        },
        body: JSON.stringify({
          usuarioId: usuarioSeleccionadoId, 
          categoriaId,
          profesion,
          telefono,
          ubicacion,
          descripcion,
          experienciaAnos: Number(experienciaAnos) || 0
        }),
      });

      const data = await respuesta.json();
      if (!respuesta.ok) throw new Error(data.error || 'No se pudo crear el perfil');

      mostrarMensaje("Éxito", "Perfil profesional creado con éxito");
      setModalVisible(false);
      setProfesion(''); setTelefono(''); setUbicacion(''); setDescripcion(''); setExperienciaAnos(''); setCategoriaId('');
      cargarDatosIniciales(); 
    } catch (error) {
      mostrarMensaje("Error", error.message);
    }
  }

  async function handleEliminarPerfil(idPerfil) {
    try {
      const token = await AsyncStorage.getItem('token');
      const respuesta = await fetch(`${API_URL_PROF}/${idPerfil}`, {
        method: 'DELETE',
        headers: { 'Authorization': 'Bearer ' + token },
      });

      const data = await respuesta.json();
      if (!respuesta.ok) throw new Error(data.error || 'No se pudo eliminar el perfil');

      mostrarMensaje("Éxito", "Perfil profesional eliminado");
      setModalVisible(false);
      cargarDatosIniciales(); 
    } catch (error) {
      mostrarMensaje("Error", error.message);
    }
  }

  const mostrarMensaje = (titulo, mensaje) => {
    if (Platform.OS === 'web') {
      alert(`${titulo}: ${mensaje}`);
    } else {
      Alert.alert(titulo, mensaje);
    }
  };

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>Selecciona un Usuario</Text>
      
      <FlatList
        data={usuarios}
        keyExtractor={(item) => item._id || item.id || Math.random().toString()}
        refreshing={cargando}
        onRefresh={cargarDatosIniciales}
        renderItem={({ item }) => {
          const esMiUsuario = item._id === miIdUsuario;
          const tieneReg = profesionalesRegistrados.some(p => (p.usuarioId?._id || p.usuarioId) === item._id);

          return (
            <TouchableOpacity 
              style={[styles.itemCard, esMiUsuario && styles.cardMiUsuario]} 
              onPress={() => handleVerUsuario(item)}
            >
              <View style={styles.infoLeft}>
                <View style={[styles.badge, esMiUsuario && styles.badgeMiUsuario]} />
                <View>
                  <Text style={styles.itemTexto}>
                    {item.username} {esMiUsuario && "(Tú)"}
                  </Text>
                  <Text style={styles.itemSubtexto}>
                    {item.email} {tieneReg ? " • 🟢 Con Perfil" : " • ⚪ Sin Perfil"}
                  </Text>
                </View>
              </View>
              <Text style={styles.verTexto}>Ver ➔</Text>
            </TouchableOpacity>
          );
        }}
        ListEmptyComponent={
          <Text style={styles.textoVacio}>No hay usuarios disponibles.</Text>
        }
      />

      {/* MODAL CONDICIONAL */}
      <Modal visible={modalVisible} animationType="slide" transparent={true}>
        <View style={styles.modalBackdrop}>
          <View style={styles.modalContainer}>
            
            {tienePerfil ? (
              <View>
                <Text style={styles.modalTitulo}>Perfil Profesional Encontrado</Text>
                <Text style={styles.textoDato}>💼 <Text style={styles.negrita}>Profesión:</Text> {perfilActual?.profesion}</Text>
                
                {/* Mostramos el nombre de la categoría si viene poblada, o el ID */}
                <Text style={styles.textoDato}>🏷️ <Text style={styles.negrita}>Categoría:</Text> {perfilActual?.categoriaId?.nombre || 'Categoría asignada'}</Text>
                
                <Text style={styles.textoDato}>📍 <Text style={styles.negrita}>Ubicación:</Text> {perfilActual?.ubicacion}</Text>
                <Text style={styles.textoDato}>📞 <Text style={styles.negrita}>Teléfono:</Text> {perfilActual?.telefono}</Text>
                <Text style={styles.textoDato}>📝 <Text style={styles.negrita}>Descripción:</Text> {perfilActual?.descripcion || 'Sin descripción'}</Text>
                <Text style={styles.textoDato}>⏳ <Text style={styles.negrita}>Experiencia:</Text> {perfilActual?.experienciaAnos} años</Text>

                <TouchableOpacity 
                  style={styles.botonEliminarModal} 
                  onPress={() => handleEliminarPerfil(perfilActual._id)}
                >
                  <Text style={styles.textoBotonEliminar}>Eliminar Perfil Profesional</Text>
                </TouchableOpacity>
              </View>
            ) : (
              <ScrollView showsVerticalScrollIndicator={false}>
                <Text style={styles.modalTitulo}>Registrar Perfil Profesional</Text>
                
                {/* SELECTOR / SPINNER DE CATEGORÍAS */}
                <Text style={styles.labelSelector}>Selecciona una Categoría:</Text>
                <View style={styles.selectorContainer}>
                  {listaCategorias.length === 0 ? (
                    <Text style={styles.textoVacioSelector}>No hay categorías creadas aún.</Text>
                  ) : (
                    listaCategorias.map((cat) => {
                      const seleccionada = categoriaId === cat._id;
                      return (
                        <TouchableOpacity
                          key={cat._id}
                          style={[styles.catOption, seleccionada && styles.catOptionSelected]}
                          onPress={() => setCategoriaId(cat._id)}
                        >
                          <Text style={[styles.catOptionText, seleccionada && styles.catOptionTextSelected]}>
                            {cat.nombre}
                          </Text>
                        </TouchableOpacity>
                      );
                    })
                  )}
                </View>

                <TextInput style={styles.input} placeholder="Profesión o Título" placeholderTextColor="#64748b" value={profesion} onChangeText={setProfesion} />
                <TextInput style={styles.input} placeholder="Teléfono" placeholderTextColor="#64748b" keyboardType="phone-pad" value={telefono} onChangeText={setTelefono} />
                <TextInput style={styles.input} placeholder="Ubicación o Ciudad" placeholderTextColor="#64748b" value={ubicacion} onChangeText={setUbicacion} />
                <TextInput style={styles.input} placeholder="Descripción" placeholderTextColor="#64748b" value={descripcion} onChangeText={setDescripcion} />
                <TextInput style={styles.input} placeholder="Años de experiencia" placeholderTextColor="#64748b" keyboardType="numeric" value={experienciaAnos} onChangeText={setExperienciaAnos} />

                <TouchableOpacity style={styles.botonCrearModal} onPress={handleCrearPerfil}>
                  <Text style={styles.textoBotonCrear}>Guardar Perfil</Text>
                </TouchableOpacity>
              </ScrollView>
            )}

            <TouchableOpacity style={styles.botonCerrar} onPress={() => setModalVisible(false)}>
              <Text style={styles.textoCerrar}>Cerrar</Text>
            </TouchableOpacity>

          </View>
        </View>
      </Modal>

    </View>
  );
}


