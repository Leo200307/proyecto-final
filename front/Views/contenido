import React, { useEffect, useState } from 'react';
import { 
  View, Text, TextInput,TouchableOpacity,FlatList, StyleSheet, Platform,Alert
} from "react-native";
import { getUsers, registerUser, deleteUser } from "../api/UserApi";

export default function Usuarios() {
  const [usuarios, setUsuarios] = useState([]);
  const [cargando, setCargando] = useState(true);

  const [username, setUsername] = useState('');
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');

  useEffect(() => {
    cargarUsuarios();
  }, []);

  async function cargarUsuarios() {
    try {
      setCargando(true);
      const datos = await getUsers();
      setUsuarios(datos.users); 
    } catch (error) {
      mostrarMensaje("Error", "No se pudieron cargar los usuarios");
    } finally {
      setCargando(false);
    }
  }

  async function handleRegister() {
    if (!username || !email || !password) {
      mostrarMensaje("Atención", "Por favor completa todos los campos");
      return;
    }

    try {
      await registerUser({ username, email, password });
      mostrarMensaje("Éxito", "Usuario registrado correctamente");
      setUsername('');
      setEmail('');
      setPassword('');
      cargarUsuarios();
    } catch (error) {
      mostrarMensaje("Error", error.message);
    }
  }

  async function handleDelete(id) {
    try {
      await deleteUser(id);
      mostrarMensaje("Éxito", "Usuario eliminado correctamente");
      cargarUsuarios();
    } catch (error) {
      mostrarMensaje("Error", error.message);
    }
  }

  const mostrarMensaje = (titulo, mensaje) => {
    if (Platform.OS === 'web') {
      alert(`${titulo}: ${mensaje}`);
    } else {
      Alert.alert(titulo, mensaje);
    }
  };

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>Gestión de Usuarios</Text>
      
      <View style={styles.formContainer}>
        <Text style={styles.subtituloForm}>Registrar Nuevo Usuario</Text>
        <TextInput
          style={styles.input}
          placeholder="Nombre de usuario"
          placeholderTextColor="#64748b"
          value={username}
          onChangeText={setUsername}
          autoComplete="off"
        />
        <TextInput
          style={styles.input}
          placeholder="Correo electrónico"
          placeholderTextColor="#64748b"
          keyboardType="email-address"
          autoCapitalize="none"
          value={email}
          onChangeText={setEmail} 
          autoComplete="off"
        />
        <TextInput
          style={styles.input}
          placeholder="Contraseña"
          placeholderTextColor="#64748b"
          secureTextEntry
          value={password}
          onChangeText={setPassword}
          autoComplete="new-password"
        />
        
        <TouchableOpacity style={styles.botonCrear} onPress={handleRegister}>
          <Text style={styles.textoBotonCrear}>Guardar Usuario</Text>
        </TouchableOpacity>
      </View>

      <Text style={styles.subtitulo}>Lista de Usuarios Registrados</Text>
      
      <FlatList
        data={usuarios}
        keyExtractor={(item) => item._id || item.id || Math.random().toString()}
        refreshing={cargando}
        onRefresh={cargarUsuarios}
        renderItem={({ item }) => (
          <View style={styles.itemCard}>
            <View style={styles.infoLeft}>
              <View style={styles.badge} />
              <View>
                <Text style={styles.itemTexto}>{item.username}</Text>
                <Text style={styles.itemSubtexto}>{item.email}</Text>
                <Text style={styles.rolBadge}>Rol: {item.rol?.nombre || 'Sin rol'}</Text>
              </View>
            </View>

            <TouchableOpacity 
              style={styles.botonEliminar} 
              onPress={() => handleDelete(item._id)}
            >
              <Text style={styles.textoBotonEliminar}>Eliminar</Text>
            </TouchableOpacity>
          </View>
        )}
        ListEmptyComponent={
          <Text style={styles.textoVacio}>No hay usuarios registrados aún.</Text>
        }
      />
    </View>
  );
}


