import React, { useEffect, useState } from 'react';
import { 
  View, Text, TextInput,TouchableOpacity,FlatList, StyleSheet, Platform,Alert} from "react-native";
import { getCategorias, crearCategoria, eliminarCategoria } from "../api/CategoriaApi";

export default function Categoria() {
  const [categorias, setCategorias] = useState([]);
  const [cargando, setCargando] = useState(true);

  const [nombre, setNombre] = useState('');
  const [descripcion, setDescripcion] = useState('');

  useEffect(() => {
    cargarDatos();
  }, []);

  async function cargarDatos() {
    try {
      setCargando(true);
      const datos = await getCategorias();
      setCategorias(datos);
    } catch (error) {
      mostrarMensaje("Error", error.message || "No se pudieron cargar las categorías");
    } finally {
      setCargando(false);
    }
  }

  async function handleCrear() {
    if (!nombre.trim()) {
      mostrarMensaje("Atención", "El nombre de la categoría es obligatorio");
      return;
    }

    try {
      await crearCategoria({ nombre, descripcion });
      mostrarMensaje("Éxito", "Categoría creada correctamente");
      setNombre('');
      setDescripcion('');
      cargarDatos();
    } catch (error) {
      mostrarMensaje("Error", error.message);
    }
  }

  async function handleDelete(id) {
    try {
      await eliminarCategoria(id);
      mostrarMensaje("Éxito", "Categoría eliminada");
      cargarDatos();
    } catch (error) {
      mostrarMensaje("Error", error.message);
    }
  }

  const mostrarMensaje = (titulo, mensaje) => {
    if (Platform.OS === 'web') {
      alert(`${titulo}: ${mensaje}`);
    } else {
      Alert.alert(titulo, mensaje);
    }
  };

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>Gestión de Categorías</Text>
      
      {/* Formulario */}
      <View style={styles.formContainer}>
        <Text style={styles.subtituloForm}>Nueva Categoría</Text>
        
        <TextInput 
          style={styles.input} 
          placeholder="Nombre de la categoría" 
          placeholderTextColor="#64748b" 
          value={nombre} 
          onChangeText={setNombre} 
        />
        
        <TextInput 
          style={styles.input} 
          placeholder="Descripción (opcional)" 
          placeholderTextColor="#64748b" 
          value={descripcion} 
          onChangeText={setDescripcion} 
        />

        <TouchableOpacity style={styles.botonCrear} onPress={handleCrear}>
          <Text style={styles.textoBotonCrear}>Guardar Categoría</Text>
        </TouchableOpacity>
      </View>

      <Text style={styles.subtitulo}>Categorías Existentes</Text>

      {/* Lista */}
      <FlatList
        data={categorias}
        keyExtractor={(item) => item._id || item.id || Math.random().toString()}
        refreshing={cargando}
        onRefresh={cargarDatos}
        renderItem={({ item }) => (
          <View style={styles.itemCard}>
            <View style={styles.infoLeft}>
              <View style={styles.badge} />
              <View style={{ flex: 1 }}>
                <Text style={styles.itemTexto}>{item.nombre}</Text>
                <Text style={styles.itemSubtexto}>{item.descripcion || 'Sin descripción'}</Text>
              </View>
            </View>

            <TouchableOpacity 
              style={styles.botonEliminar} 
              onPress={() => handleDelete(item._id)}
            >
              <Text style={styles.textoBotonEliminar}>Eliminar</Text>
            </TouchableOpacity>
          </View>
        )}
        ListEmptyComponent={
          <Text style={styles.textoVacio}>No hay categorías registradas aún.</Text>
        }
      />
    </View>
  );
}



