auth usuario ---------------------------------------------------------------------------------------------


const express = require('express');
const router = express.Router();
const { login, register, deleteUser, getUsers, updateUser } = require('../controllers/authController');
const verifyToken = require('../middleware/verifyToken');
//const checkRole = require('../middleware/checkRole');


router.post('/login', login);
router.post('/register', register);
router.delete('/users/:id', verifyToken, deleteUser);
router.get('/users', verifyToken,  getUsers);
router.put('/users/:id', verifyToken, updateUser);
module.exports = router;


calificacion ---------------------------------------------------------------------------------------------

const express = require('express');
const router = express.Router();
const { create, getByProfesional, update, destroy } = require('../controllers/calificacionController');
const verifyToken = require('../middleware/verifyToken');
//const checkRole = require('../middleware/checkRole');

// 1. Ver las reseñas de un profesional (Autenticado)
router.get('/profesional/:profesionalId', verifyToken, getByProfesional);

// 2. Crear / Dejar una reseña (Autenticado)
router.post('/', verifyToken, create);

// 3. Editar una reseña existente (Autenticado)
router.put('/:id', verifyToken, update);

// 4. Eliminar permanentemente una reseña (Autenticado)
router.delete('/:id', verifyToken, destroy);

module.exports = router;

