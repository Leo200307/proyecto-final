const express = require('express');
const router = express.Router();
const { index, create, show, destroy, update } = require('../controllers/categoriaController');

const verifyToken = require('../middleware/verifyToken');
//const checkRole = require('../middleware/checkRole');

// Cualquier usuario autenticado puede ver las categorías (para la Pantalla 1 de la App)
router.get('/',  index);
router.get('/:id', show);

// Solo usuarios con rol 'admin' pueden registrar categorías
router.post('/',  verifyToken,  create);
router.delete('/:id', verifyToken,  destroy);
router.put('/:id', verifyToken, update);

module.exports = router;



