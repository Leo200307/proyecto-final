const jwt = require('jsonwebtoken');

const verifyToken = (req, res, next) => {
    const authHeader = req.headers.authorization;

    // 1. Validar que exista el encabezado Authorization y empiece con 'Bearer '
    if (!authHeader || !authHeader.startsWith('Bearer ')) {
        return res.status(401).json({ error: 'Acceso denegado: Token no proporcionado' });
    }

    // 2. Extraer el token separando 'Bearer <TOKEN>' (corregido .split)
    const token = authHeader.split(' ')[1];

    try {
        // 3. Verificar el token usando la firma secreta
        const decoded = jwt.verify(token, process.env.JWT_SECRET);
        
        // 4. Inyectar la información descodificada del usuario en el objeto req
        req.user = decoded;
        
        // 5. Continuar al controlador de la ruta
        next();
    } catch (error) {
        return res.status(401).json({ error: 'Token inválido o expirado' });
    }
};

module.exports = verifyToken;
