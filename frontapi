import AsyncStorage from "@react-native-async-storage/async-storage";

const API_URL = 'http://localhost:5000/api/auth/users';
const AUTH_URL = 'http://localhost:5000/api/auth';


export async function getUsers() {
  try {
    const token = await AsyncStorage.getItem('token');
    
    const respuesta = await fetch(API_URL, {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + token,
      },
    });

    const data = await respuesta.json();

    if (!respuesta.ok) {
      throw new Error(data.error || 'Error al obtener los usuarios');
    } 
    
    return data;
  } catch (error) {
    console.error("EXCEPCIÓN CAPTURADA EN getUsers:", error);
    throw error;
  }
}


export async function registerUser(userData) {
  try {
    const respuesta = await fetch(`${AUTH_URL}/register`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
