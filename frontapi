import AsyncStorage from "@react-native-async-storage/async-storage";

const API_URL_PROF = 'http://localhost:5000/api/profesionales';
const API_URL_CALIF = 'http://localhost:5000/api/calificaciones';


export async function getProfesionales() {
  try {
    const token = await AsyncStorage.getItem('token');
    const respuesta = await fetch(API_URL_PROF, {
      method: 'GET',
      headers: { 'Authorization': 'Bearer ' + token },
    });
    const data = await respuesta.json();
    if (!respuesta.ok) throw new Error(data.error || 'No se pudieron cargar los profesionales');
    return Array.isArray(data) ? data : (data.profesionales || data.data || []);
  } catch (error) {
    throw error;
  }
}


export async function getCalificacionesPorProfesional(id) {
  try {
    const token = await AsyncStorage.getItem('token');
    
  
    let respuesta = await fetch(`${API_URL_CALIF}/profesional/${id}`, {
      method: 'GET',
      headers: { 'Authorization': 'Bearer ' + token },
    });

   
    if (!respuesta.ok) {
      respuesta = await fetch(`${API_URL_CALIF}/usuario/${id}`, {
        method: 'GET',
        headers: { 'Authorization': 'Bearer ' + token },
      });
    }

    const data = await respuesta.json();
    if (!respuesta.ok) return []; 
    
    return Array.isArray(data) ? data : (data.calificaciones || data.data || []);
  } catch (error) {
    return [];
  }
}


export async function crearCalificacion(datosCalificacion) {
  try {
    const token = await AsyncStorage.getItem('token');
    const respuesta = await fetch(API_URL_CALIF, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + token,
      },
      body: JSON.stringify(datosCalificacion),
    });
    const data = await respuesta.json();
    if (!respuesta.ok) throw new Error(data.error || 'No se pudo crear la calificación');
    return data;
  } catch (error) {
    throw error;
  }
}


export async function eliminarCalificacion(id) {
  try {
    const token = await AsyncStorage.getItem('token');
    const respuesta = await fetch(`${API_URL_CALIF}/${id}`, {
      method: 'DELETE',
      headers: { 'Authorization': 'Bearer ' + token },
    });
    const data = await respuesta.json();
    if (!respuesta.ok) throw new Error(data.error || 'No se pudo eliminar la calificación');
    return data;
  } catch (error) {
    throw error;
  }
}


