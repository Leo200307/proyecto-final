const Profesional = require('../models/profecional');


const index = async (req, res) => {
    try {
        const { categoriaId, search } = req.query;
        let query = { estado: true };

        // Filtrar por categoría si viene en los query params (?categoriaId=...)
        if (categoriaId) {
            query.categoriaId = categoriaId;
        }

        // Buscar por texto en profesión o ubicación (?search=electricista)
        if (search) {
            query.$or = [
                { profesion: { $regex: search, $options: 'i' } },
                { ubicacion: { $regex: search, $options: 'i' } },
                { servicios: { $regex: search, $options: 'i' } }
            ];
        }

        const profesionales = await Profesional.find(query)
            .populate('usuarioId', 'username email')
            .populate('categoriaId', 'nombre');

        res.status(200).json(profesionales);
    } catch (error) {
        res.status(500).json({ error: error.message });
    }
};


const create = async (req, res) => {
    try {
        // PERMITIR USAR EL usuarioId QUE VIENE DEL FRONTEND (si se envía), 
        // o recurrir al usuario del token si no se especifica.
        const usuarioIdAUsar = req.body.usuarioId || req.user?.id || req.user?._id;

        if (!usuarioIdAUsar) {
            return res.status(400).json({ error: 'El ID de usuario es obligatorio' });
        }

        // Verificar si ESTE usuario específico ya tiene un perfil profesional registrado
        const existePerfil = await Profesional.findOne({ usuarioId: usuarioIdAUsar });
        if (existePerfil) {
            return res.status(400).json({ error: 'Este usuario ya tiene un perfil profesional registrado' });
        }

        const nuevoProfesional = new Profesional({
            ...req.body,
            usuarioId: usuarioIdAUsar // Aseguramos que guarde el ID correcto del usuario seleccionado
        });

        const profesionalGuardado = await nuevoProfesional.save();
        res.status(201).json(profesionalGuardado);
