const Calificacion = require('../models/calificacion');
const Profesional = require('../models/profecional');


const create = async (req, res) => {
    try {
        const usuarioId = req.user?.id || req.user?._id || req.body.usuarioId;
        const { profesionalId, puntuacion, comentario } = req.body;

        if (!usuarioId) {
            return res.status(400).json({ error: 'El usuarioId es obligatorio para calificar' });
        }

        // Verificar si el profesional existe
        const profesional = await Profesional.findById(profesionalId);
        if (!profesional) {
            return res.status(404).json({ error: 'Profesional no encontrado' });
        }

        // Guardar o actualizar la calificación (Upsert)
        const calificacion = await Calificacion.findOneAndUpdate(
            { profesionalId, usuarioId },
            { puntuacion, comentario },
            { new: true, upsert: true, runValidators: true }
        );

        // Recalcular el promedio y total de reseñas para el profesional
        const todasLasCalificaciones = await Calificacion.find({ profesionalId });
        const totalResenas = todasLasCalificaciones.length;
        const sumaPuntuaciones = todasLasCalificaciones.reduce((acc, c) => acc + c.puntuacion, 0);
        const promedioCalificacion = (sumaPuntuaciones / totalResenas).toFixed(1);

        // Actualizar datos en el perfil del profesional
        await Profesional.findByIdAndUpdate(profesionalId, {
            promedioCalificacion: Number(promedioCalificacion),
            totalResenas
        });

        res.status(201).json({
            mensaje: 'Calificación registrada correctamente',
            calificacion
        });
    } catch (error) {
        if (error.code === 11000) {
            return res.status(400).json({ error: 'Ya has calificado a este profesional anteriormente' });
        }
        res.status(400).json({ error: error.message });
    }
};


const getByProfesional = async (req, res) => {
    try {
        const { profesionalId } = req.params;

        const calificaciones = await Calificacion.find({ profesionalId })
            .populate('usuarioId', 'username email')
            .sort({ createdAt: -1 });

        res.status(200).json(calificaciones);
    } catch (error) {
        res.status(500).json({ error: error.message });
    }
};


const update = async (req, res) => {
    try {
        const { id } = req.params; // ID de la calificación
        const { puntuacion, comentario } = req.body;

        const calificacion = await Calificacion.findByIdAndUpdate(
            id,
            { puntuacion, comentario },
            { new: true, runValidators: true }
        );

        if (!calificacion) {
            return res.status(404).json({ error: 'Calificación no encontrada' });
        }

        // Recalcular promedio y total de reseñas del profesional
        const todasLasCalificaciones = await Calificacion.find({ profesionalId: calificacion.profesionalId });
        const totalResenas = todasLasCalificaciones.length;
        const sumaPuntuaciones = todasLasCalificaciones.reduce((acc, c) => acc + c.puntuacion, 0);
        const promedioCalificacion = totalResenas > 0 ? (sumaPuntuaciones / totalResenas).toFixed(1) : 0;

        await Profesional.findByIdAndUpdate(calificacion.profesionalId, {
            promedioCalificacion: Number(promedioCalificacion),
            totalResenas
        });

        res.status(200).json({
            mensaje: 'Calificación actualizada correctamente',
            calificacion
        });
    } catch (error) {
        res.status(400).json({ error: error.message });
    }
};

const destroy = async (req, res) => {
    try {
        const { id } = req.params; // ID de la calificación

        // Eliminar directamente de MongoDB
        const calificacionEliminada = await Calificacion.findByIdAndDelete(id);

        if (!calificacionEliminada) {
            return res.status(404).json({ error: 'Calificación no encontrada' });
        }

        // Recalcular promedio tras eliminar
        const todasLasCalificaciones = await Calificacion.find({ profesionalId: calificacionEliminada.profesionalId });
        const totalResenas = todasLasCalificaciones.length;
        const sumaPuntuaciones = todasLasCalificaciones.reduce((acc, c) => acc + c.puntuacion, 0);
        const promedioCalificacion = totalResenas > 0 ? (sumaPuntuaciones / totalResenas).toFixed(1) : 0;

        await Profesional.findByIdAndUpdate(calificacionEliminada.profesionalId, {
            promedioCalificacion: Number(promedioCalificacion),
            totalResenas
        });

        res.status(200).json({
            mensaje: 'Calificación eliminada permanentemente de la base de datos',
            calificacion: calificacionEliminada
        });
    } catch (error) {
        res.status(500).json({ error: error.message });
    }
};

module.exports = { create, getByProfesional, update, destroy };



